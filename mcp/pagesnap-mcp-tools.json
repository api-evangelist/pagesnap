          },
          "threshold_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Minimum visual-change percentage that triggers an event"
          },
          "webhook_url": {
            "type": "string",
            "description": "Optional HTTPS endpoint to notify when content changes"
          },
          "width": {
            "type": "integer",
            "minimum": 200,
            "maximum": 3840,
