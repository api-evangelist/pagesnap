    {
      "name": "screenshot_url",
      "title": "Screenshot a URL",
      "description": "Render a web page in a headless browser and return a screenshot image (plus a temporary URL to the file, valid 1 hour). Use it to visually verify pages, capture charts, or show a human what a page looks like. Example: screenshot_url({ url: \"https://example.com\", width: 1280, height: 800, format: \"png\" }).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public HTTP(S) URL to capture"
          },
          "width": {
            "type": "integer",
            "minimum": 200,
            "maximum": 3840,
            "description": "Viewport width in CSS pixels (default 1280)"
          },
          "height": {
            "type": "integer",
            "minimum": 200,
            "maximum": 10000,
            "description": "Viewport height in CSS pixels (default 800)"
          },
          "full_page": {
            "type": "boolean",
            "description": "Capture the full scrollable page instead of the viewport"
          },
          "dark": {
            "type": "boolean",
            "description": "Emulate a dark color scheme"
          },
          "device": {
            "type": "string",
            "description": "Device preset, e.g. \"iPhone 14\", \"Pixel 7\", or \"iPad Pro 11\""
          },
          "wait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Extra milliseconds to wait after load"
          },
          "selector": {
            "type": "string",
            "description": "CSS selector to clip the screenshot to"
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "description": "Image format; default jpeg is smallest for LLM context"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "click",
                    "hover",
                    "fill",
                    "select",
                    "press",
                    "scroll",
                    "wait",
                    "wait_for",
                    "hide",
                    "remove",
                    "set_viewport"
                  ],
                  "description": "Browser action to perform before capture"
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "CSS selector targeted by the action"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 100
                    }
                  ],
                  "description": "Text or option value for fill/select actions"
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Keyboard key for a press action"
                },
                "x": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000,
                  "description": "Horizontal scroll delta or coordinate"
                },
                "y": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000,
                  "description": "Vertical scroll delta or coordinate"
                },
                "ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5000,
                  "description": "Bounded wait duration in milliseconds"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "attached",
                    "detached",
                    "visible",
                    "hidden"
                  ],
                  "description": "DOM state awaited by wait_for"
                },
                "width": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 3840,
                  "description": "Viewport width for set_viewport"
                },
                "height": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 10000,
                  "description": "Viewport height for set_viewport"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "maxItems": 10,
            "description": "Up to 10 validated pre-capture browser actions"
          },
          "lang": {
            "type": "string",
            "maxLength": 35,
            "description": "BCP-47 language tag, default en-US"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
