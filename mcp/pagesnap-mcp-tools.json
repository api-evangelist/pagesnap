      "name": "create_monitor",
      "title": "Create a change monitor",
      "description": "Create a persisted text, visual, or metadata monitor. A Pagesnap API key is required. The webhook signing secret is returned only by this call. Example: create_monitor({ url: \"https://example.com\", mode: \"text\", interval: \"24h\" }).",
