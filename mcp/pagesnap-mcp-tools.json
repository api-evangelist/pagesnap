{
  "tools": [
    {
      "name": "read_url",
      "title": "Read URL as Markdown",
      "description": "Fetch a public web page and return extracted main content as Markdown (or plain text / JSON with title, author, links, and images). It can handle JavaScript-rendered pages (set render=true to force a headless browser), PDFs, and plain text; extraction can omit content on unusual layouts. Example: read_url({ url: \"https://example.com\", format: \"markdown\" }). Keyless per-call HTTP alternative: https://pagesnap.142-93-197-141.sslip.io/x402/v1/read ($0.002 USDC on Base).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The http(s) URL to read"
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "json",
              "aria",
              "links"
            ],
            "description": "Output format (default markdown; aria forces browser rendering)"
          },
          "render": {
            "type": "boolean",
            "description": "Force headless-browser rendering for JavaScript-heavy pages"
          },
          "lang": {
            "type": "string",
            "maxLength": 35,
            "description": "BCP-47 language tag, default en-US"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 500,
            "maximum": 200000,
            "description": "Truncate output to this many characters (default 60000)"
          },
          "page_markers": {
            "type": "boolean",
            "description": "For PDFs, include <!-- page N --> markers"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "org.pagesnap/x402": {
          "protocolVersion": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "endpoint": "https://pagesnap.142-93-197-141.sslip.io/x402/v1/read",
          "price": "0.002",
          "pricing": "fixed",
          "note": "This is an optional keyless HTTP equivalent; the MCP tool itself uses the normal anonymous/key quota."
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "json",
              "aria",
              "links"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "format"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "crawl_site",
      "title": "Crawl a site as Markdown",
      "description": "Crawl up to 25 robots-aware, same-origin pages and concatenate clean Markdown with a source header for each page. Useful for RAG ingestion and documentation discovery. Example: crawl_site({ url: \"https://example.com/docs\", limit: 5, max_depth: 2 }).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public HTTP(S) URL at which to start crawling"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Maximum pages to return (default 20; anonymous plans may allow fewer)"
          },
          "max_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "Maximum link depth from the starting page (default 3)"
          },
          "same_origin": {
            "type": "boolean",
            "description": "Restrict links to the starting origin (default true)"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Optional URL patterns to include"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Optional URL patterns to exclude"
          },
          "use_sitemap": {
            "type": "boolean",
            "description": "Use same-origin sitemap URLs when available (default true)"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 200000,
            "description": "Truncate the combined Markdown to this many characters (default 60000)"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "org.pagesnap/x402": {
          "protocolVersion": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "endpoint": "https://pagesnap.142-93-197-141.sslip.io/x402/v1/crawl",
          "price": "0.002/page (maximum 25 pages)",
          "pricing": "per-page",
          "note": "This is an optional keyless HTTP equivalent; the MCP tool itself uses the normal anonymous/key quota."
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "stats": {
            "$ref": "#/properties/pages/items"
          },
          "robots": {
            "$ref": "#/properties/pages/items"
          }
        },
        "required": [
          "pages",
          "stats",
          "robots"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
