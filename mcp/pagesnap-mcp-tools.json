          "mode": {
            "type": "string",
            "enum": [
              "text",
              "visual",
              "meta"
            ],
            "description": "Comparison mode (default text)"
          },
          "interval": {
            "type": "string",
            "enum": [
              "1h",
              "6h",
              "24h"
            ],
            "description": "Check frequency (default 24h)"
          },
          "selector": {
            "type": "string",
            "maxLength": 1000,
