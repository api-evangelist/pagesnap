              "type": "string"
            },
            "maxItems": 50,
            "description": "Optional URL patterns to include"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Optional URL patterns to exclude"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 200000,
            "description": "Truncate the combined generated files to this many characters (default 100000)"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
