        "org.pagesnap/x402": {
          "protocolVersion": 2,
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "endpoint": "https://pagesnap.142-93-197-141.sslip.io/x402/v1/screenshot",
          "price": "0.005",
          "pricing": "fixed",
          "note": "This is an optional keyless HTTP equivalent; the MCP tool itself uses the normal anonymous/key quota."
        }
      }
